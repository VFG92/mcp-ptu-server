# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# MCP Server Configuration
MCP_SERVER_NAME=mcp-ptu-server
MCP_SERVER_VERSION=2.0.0

# Capability System
CAPABILITY_SYSTEM_ENABLED=true
LEGACY_PERSONA_SYSTEM_ENABLED=true

# Budget Defaults
DEFAULT_MAX_TOKENS_IN=10000
DEFAULT_MAX_TOKENS_OUT=10000
DEFAULT_MAX_CPU_MS=10000
DEFAULT_MAX_SUBREQUESTS=50

# Monitoring & Logging
ENABLE_LOGGING=true
LOG_LEVEL=info

# Feature Flags
TOURNAMENT_MODE_ENABLED=true
EVIDENCE_TRACKING_ENABLED=true
CONFIDENCE_CALCULUS_ENABLED=true

# Performance
MAX_CONCURRENT_CAPABILITIES=10
WAVE_EXECUTION_ENABLED=true

